rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'emmanuelalvarico4@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'volunteer' || isAdmin()
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])
      );
      allow delete: if isAdmin();
    }

    // Initiatives / Drives
    match /initiatives/{initiativeId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined', 'comments'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Real-time Chat channel subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
      }

      // Q&A Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Volunteer Registrations & Attendance Roster
    match /registrations/{registrationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Organizer Applications & Review Flow
    match /organizerRequests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isOwner(userId) && resource.data.status == 'pending');
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Certificates for Public QR Verification
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Admin Markers
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
