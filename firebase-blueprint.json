{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "bloodType": { "type": "string", "maxLength": 10 },
        "role": { "type": "string", "enum": ["volunteer", "organizer", "admin"] },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "city": { "type": "string", "maxLength": 100 },
        "emergencyContactName": { "type": "string", "maxLength": 100 },
        "emergencyContactPhone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Initiative": {
      "title": "Initiative",
      "description": "Community volunteer drive or initiative",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "region": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 3000 },
        "capacity": { "type": "number" },
        "joined": { "type": "number" },
        "whatToBring": { "type": "array" },
        "meetPoint": { "type": "string", "maxLength": 200 },
        "organizerName": { "type": "string", "maxLength": 100 },
        "organizerContact": { "type": "string", "maxLength": 100 },
        "impactGoal": { "type": "string", "maxLength": 300 },
        "perks": { "type": "array" },
        "userId": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "date", "location", "description", "capacity", "userId"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Volunteer registration record for an initiative",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "initiativeId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 120 },
        "userPhone": { "type": "string", "maxLength": 30 },
        "userBloodType": { "type": "string", "maxLength": 10 },
        "checkedIn": { "type": "boolean" },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["initiativeId", "userId", "registeredAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time chat message in an initiative chat channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "initiativeId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "text", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Public Q&A comment on an initiative",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "initiativeId": { "type": "string" },
        "author": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "avatarColor": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["author", "text", "createdAt"]
    },
    "OrganizerRequest": {
      "title": "OrganizerRequest",
      "description": "Application submitted by a volunteer to upgrade to organizer role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 120 },
        "reason": { "type": "string", "maxLength": 2000 },
        "organizationOrBarangay": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["userId", "reason", "organizationOrBarangay", "status", "submittedAt"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Issued volunteerism certificate for verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "initiativeId": { "type": "string" },
        "initiativeTitle": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string" },
        "volunteerName": { "type": "string", "maxLength": 100 },
        "dateIssued": { "type": "string", "maxLength": 50 },
        "organizerName": { "type": "string", "maxLength": 100 },
        "verificationCode": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["initiativeId", "initiativeTitle", "userId", "volunteerName", "verificationCode", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with role"
    },
    "/initiatives/{initiativeId}": {
      "schema": { "$ref": "#/entities/Initiative" },
      "description": "Community volunteer drives"
    },
    "/initiatives/{initiativeId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Live chat channel for participants of an initiative"
    },
    "/initiatives/{initiativeId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Q&A comments on initiatives"
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Volunteer registrations and attendance status"
    },
    "/organizerRequests/{userId}": {
      "schema": { "$ref": "#/entities/OrganizerRequest" },
      "description": "Applications to become an organizer"
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Issued volunteerism certificates for public verification"
    },
    "/admins/{adminId}": {
      "schema": "string",
      "description": "List of system administrators"
    }
  }
}
